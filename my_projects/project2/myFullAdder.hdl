/**
 * Computes the sum of three bits.
 */
CHIP myFullAdder {
    IN a, b, c;  // 1-bit inputs
    OUT sum,     // Right bit of a + b + c
        carry;   // Left bit of a + b + c

    PARTS:
    //// Replace this comment with your code.
myHalfAdder(a=a, b=b, sum=aSumb, carry=aCarryb);
myHalfAdder(a=aSumb, b=c, sum=sum, carry=bCarryc);
Or(a=aCarryb, b=bCarryc, out=carry);
}